{
    "name": "dispositiontools/craft-teams",
    "description": "Create teams based on entries by inviting and managing users",
    "type": "craft-plugin",
    "license": "proprietary",
    "support": {
        "email": "support@disposition.tools",
        "issues": "https://github.com/dispositiontools/craft-teams/issues?state=open",
        "source": "https://github.com/dispositiontools/craft-teams",
        "docs": "https://github.com/dispositiontools/craft-teams",
        "rss": "https://github.com/dispositiontools/craft-teams/releases.atom"
    },
    "require": {
        "php": ">=8.0.2",
        "craftcms/cms": "^4.9.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "dispositiontools\\teams\\": "src/"
        }
    },
    "extra": {
        "handle": "teams",
        "name": "Teams",
        "developer": "Disposition Tools",
        "documentationUrl": "https://github.com/dispositiontools/craft-teams",
        "class": "dispositiontools\\teams\\Teams"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}

